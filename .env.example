# API
NODE_ENV=development
PORT=3010
DATABASE_URL=postgres://patinha:patinha@localhost:5435/patinha
REDIS_URL=redis://localhost:6380

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=patinha
MINIO_SECRET_KEY=patinha-secret
MINIO_BUCKET=patinha-media

# imgproxy (unsigned URLs are local-only; set a hex key and salt before production)
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# Auth. Local login accepts Bearer dev:<email>. Production must set this to false.
AUTH_DEV_MODE=true
FIREBASE_PROJECT_ID=
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3010
