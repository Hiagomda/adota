# API
NODE_ENV=development
PORT=3010
DATABASE_URL=postgres://patinha:patinha@localhost:5435/patinha
REDIS_URL=redis://localhost:6380

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
# Public host for presigned photo uploads. Leave empty when the phone can reach MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=patinha
MINIO_SECRET_KEY=patinha-secret
MINIO_BUCKET=patinha-media

# Cloudflare R2. Leave all four empty to keep MinIO. Set them together to store photos in R2.
# The phone uploads to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Create an R2 API token
# with Object Read and Write on this bucket. imgproxy still resizes; point it at the same host
# with R2_S3_ENDPOINT and R2_S3_REGION=auto. Allow PUT from the site in the bucket CORS policy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_S3_REGION=

# imgproxy (unsigned URLs are local-only; set a hex key and salt before production)
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# Auth. Local login accepts Bearer dev:<email>. Production must set this to false.
AUTH_DEV_MODE=true
FIREBASE_PROJECT_ID=
# Service account for revocation checks and push. Leave empty to verify ID tokens with Google's public certificates.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3010
EXPO_PUBLIC_DOWNLOAD_URL=http://download-fpmewu0com3qkbfihrsihc6y.86.48.25.233.sslip.io
# development | preview | production. Shown on the error screen and sent with crash reports.
EXPO_PUBLIC_APP_ENV=development

# Firebase Auth (public client config, from the Firebase console). Required for e-mail and Google login.
# When Google sign-in is enabled on iOS, the App Store also requires Sign in with Apple.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Crash reports (Sentry). Empty DSN = reporting off, errors only go to the console.
# The DSN is public. SENTRY_AUTH_TOKEN is only read at build time to upload source maps.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
